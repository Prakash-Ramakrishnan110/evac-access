# EvacAccess India - Environment Configuration

# Django Core Settings
SECRET_KEY=django-insecure-evacaccess-india-super-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to local PostgreSQL or Docker Compose container)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=evacaccess_india
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# System Operational Mode
OPERATION_MODE=SIMULATED_DEMO
HAZARD_FRESHNESS_THRESHOLD_MINUTES=60
